<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_11-quy-tac-an-toan" targetNamespace="http://glowskin.local/bpmn">
  <bpmn:collaboration id="Collab_11-quy-tac-an-toan">
    <bpmn:participant id="Pool_11-quy-tac-an-toan" name="Quản lý quy tắc an toàn (chống chỉ định)" processRef="Process_11-quy-tac-an-toan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_11-quy-tac-an-toan" name="Quản lý quy tắc an toàn (chống chỉ định)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_11-quy-tac-an-toan">
      <bpmn:lane id="Lane_BS" name="Bác sĩ">
        <bpmn:flowNodeRef>sB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Q" name="Quản lý chung">
        <bpmn:flowNodeRef>qrev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eRejB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eRej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="sB" name="Bác sĩ cần quy tắc mới / sửa / ngưng">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="prop" name="Soạn đề xuất kèm nguồn, lý do">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="qrev" name="Xem xét đề xuất của bác sĩ">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gB" name="Quyết định?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fixB" name="Sửa đề xuất theo góp ý">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="eRejB" name="Đề xuất bị từ chối">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="sA" name="Quản lý cần quy tắc mới / sửa / ngưng">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="draft" name="Soạn quy tắc / bản sửa / đề xuất ngưng (bắt buộc có nguồn)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="sel" name="Chọn bác sĩ xem xét">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="notify" name="Báo bác sĩ được chọn (thông báo real-time)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review" name="Xem xét, thử quy tắc, trả lời">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gR" name="Mọi bác sĩ đồng ý?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gFix" name="Sửa hay từ chối?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="eRej" name="Đã từ chối">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="appr" name="Duyệt">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="apply" name="Áp dụng ngay: quy tắc mới / bản sửa thay bản cũ / ngưng bản cũ">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Có hiệu lực ở kê đơn, thu tiền, bán tại quầy">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="sB" targetRef="prop" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="prop" targetRef="qrev" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="qrev" targetRef="gB" />
    <bpmn:sequenceFlow id="Flow_4" name="Yêu cầu sửa" sourceRef="gB" targetRef="fixB" />
    <bpmn:sequenceFlow id="Flow_5" name="Gửi lại" sourceRef="fixB" targetRef="qrev" />
    <bpmn:sequenceFlow id="Flow_6" name="Từ chối" sourceRef="gB" targetRef="eRejB" />
    <bpmn:sequenceFlow id="Flow_7" name="Gửi thêm bác sĩ" sourceRef="gB" targetRef="sel" />
    <bpmn:sequenceFlow id="Flow_8" name="Duyệt" sourceRef="gB" targetRef="appr" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="sA" targetRef="draft" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="draft" targetRef="sel" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="sel" targetRef="notify" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="notify" targetRef="review" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="review" targetRef="gR" />
    <bpmn:sequenceFlow id="Flow_14" name="Có" sourceRef="gR" targetRef="appr" />
    <bpmn:sequenceFlow id="Flow_15" name="Không" sourceRef="gR" targetRef="gFix" />
    <bpmn:sequenceFlow id="Flow_16" name="Từ chối" sourceRef="gFix" targetRef="eRej" />
    <bpmn:sequenceFlow id="Flow_17" name="Sửa, gửi lại" sourceRef="gFix" targetRef="draft" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="appr" targetRef="apply" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="apply" targetRef="e" />
  </bpmn:process>
