      <bpmn:lane id="Lane_N" name="Nhân viên bán hàng">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rev</bpmn:flowNodeRef>
