<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_12-nhap-hang" targetNamespace="http://glowskin.local/bpmn">
  <bpmn:collaboration id="Collab_12-nhap-hang">
    <bpmn:participant id="Pool_12-nhap-hang" name="Nhập hàng: đề xuất, đặt hàng, nhận hàng" processRef="Process_12-nhap-hang" />
    <bpmn:participant id="Ext_NCC" name="Nhà cung cấp" />
    <bpmn:messageFlow id="Msg_1" name="Đơn đặt hàng" sourceRef="mail" targetRef="Ext_NCC" />
    <bpmn:messageFlow id="Msg_2" name="Giao hàng" sourceRef="Ext_NCC" targetRef="wait" />
    <bpmn:messageFlow id="Msg_3" name="Chênh lệch / giao bù" sourceRef="inst" targetRef="Ext_NCC" />
  </bpmn:collaboration>
  <bpmn:process id="Process_12-nhap-hang" name="Nhập hàng: đề xuất, đặt hàng, nhận hàng" isExecutable="false">
    <bpmn:laneSet id="LaneSet_12-nhap-hang">
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_N" name="Nhân viên bán hàng">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Q" name="Quản lý">
        <bpmn:flowNodeRef>dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>po</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rev</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Tồn kho xuống tồn tối thiểu (sau bán / buổi làm)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="prop" name="Tự tạo đề xuất nhập">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="s2" name="NVBH / KTV thấy hàng sắp hết">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="req" name="Tạo đề xuất nhập">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="dec" name="Xem xét đề xuất (không tự duyệt đề xuất của mình)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Duyệt?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Đề xuất bị từ chối">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="po" name="Chọn nhà cung cấp, tạo đơn đặt hàng">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="mail" name="Gửi email + PDF đơn đặt hàng">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait" name="Hàng về">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_wait" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="chk" name="Kiểm từng dòng: số lượng, lô, NSX, HSD, tình trạng, nhãn, ảnh">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Khớp, không lỗi?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ok" name="Nhập kho theo lô">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="rev" name="Kiểm tra thực tế: nhận / trả NCC / hủy / giao bù / chốt thiếu">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="inst" name="Nhập kho số được nhận, email chênh lệch cho NCC">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g3" name="Còn chờ giao bù?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="done" name="Hoàn tất đơn, email xác nhận đã nhận hàng">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Đơn đặt hàng hoàn tất">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s1" targetRef="prop" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="prop" targetRef="dec" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="s2" targetRef="req" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="req" targetRef="dec" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="dec" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_6" name="Có" sourceRef="g1" targetRef="po" />
    <bpmn:sequenceFlow id="Flow_7" name="Không" sourceRef="g1" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="po" targetRef="mail" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="mail" targetRef="wait" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="wait" targetRef="chk" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="chk" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_12" name="Có" sourceRef="g2" targetRef="ok" />
    <bpmn:sequenceFlow id="Flow_13" name="Lệch / lỗi" sourceRef="g2" targetRef="rev" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ok" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="rev" targetRef="inst" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="inst" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_17" name="Không" sourceRef="g3" targetRef="done" />
    <bpmn:sequenceFlow id="Flow_18" name="Có" sourceRef="g3" targetRef="wait" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="done" targetRef="e2" />
  </bpmn:process>
