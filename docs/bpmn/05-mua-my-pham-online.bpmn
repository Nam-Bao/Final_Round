    <bpmn:sequenceFlow id="Flow_14" name="Thiếu" sourceRef="g2" targetRef="less" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="less" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="paid" targetRef="appr" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="appr" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_18" name="Có" sourceRef="g3" targetRef="pack" />
    <bpmn:sequenceFlow id="Flow_19" name="Không" sourceRef="g3" targetRef="ecn" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="pack" targetRef="ship" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="ship" targetRef="wg" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="wg" targetRef="md" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="wg" targetRef="mf" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="mf" targetRef="ef" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="md" targetRef="done" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="done" targetRef="rate" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="rate" targetRef="e2" />
  </bpmn:process>
