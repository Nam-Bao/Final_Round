<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_05-mua-my-pham-online" targetNamespace="http://glowskin.local/bpmn">
  <bpmn:collaboration id="Collab_05-mua-my-pham-online">
    <bpmn:participant id="Pool_05-mua-my-pham-online" name="Mua mỹ phẩm online" processRef="Process_05-mua-my-pham-online" />
    <bpmn:participant id="Ext_SePay" name="SePay / Ngân hàng" />
    <bpmn:participant id="Ext_GHN" name="Giao Hàng Nhanh" />
    <bpmn:messageFlow id="Msg_1" name="Chuyển tiền" sourceRef="pay" targetRef="Ext_SePay" />
    <bpmn:messageFlow id="Msg_2" name="Báo giao dịch" sourceRef="Ext_SePay" targetRef="msg" />
    <bpmn:messageFlow id="Msg_3" name="Tạo vận đơn" sourceRef="ship" targetRef="Ext_GHN" />
    <bpmn:messageFlow id="Msg_4" name="Báo không giao được" sourceRef="Ext_GHN" targetRef="mf" />
    <bpmn:messageFlow id="Msg_5" name="Báo đã giao" sourceRef="Ext_GHN" targetRef="md" />
  </bpmn:collaboration>
  <bpmn:process id="Process_05-mua-my-pham-online" name="Mua mỹ phẩm online" isExecutable="false">
    <bpmn:laneSet id="LaneSet_05-mua-my-pham-online">
      <bpmn:lane id="Lane_K" name="Khách hàng">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>make</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>less</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>md</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ef</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_N" name="Nhân viên bán hàng">
        <bpmn:flowNodeRef>appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ecn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Khách vào cửa hàng">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="cart" name="Chọn sản phẩm vào giỏ">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="out" name="Nhập địa chỉ, voucher, cách thanh toán">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="make" name="Tính phí GHN, trừ kho, tạo đơn">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Cách thanh toán?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="pay" name="Chuyển khoản VietQR">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="wait" name="Chờ tiền về">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="msg" name="Nhận giao dịch">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm" name="Quá 15 phút">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_tm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="exp" name="Tự hủy, nhả kho, trả lượt voucher">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e0" name="Đơn tự hủy">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="Số tiền?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="paid" name="Ghi đã trả, thừa thì ghi Đối soát">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="less" name="Ghi chuyển thiếu vào Đối soát">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="CSKH xử lý">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="appr" name="Kiểm tra đơn">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="Duyệt?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ecn" name="Sang quy trình Hủy đơn">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="pack" name="Đóng gói">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ship" name="Tạo vận đơn GHN, bàn giao">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="wg" name="Chờ GHN báo">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="md" name="Giao thành công">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_md" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="done" name="Hoàn thành đơn">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="rate" name="Nhận hàng, đánh giá sản phẩm">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e2" name="Kết thúc">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="mf" name="GHN hủy hoặc hoàn hàng">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_mf" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ef" name="Sang quy trình Hủy đơn">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="cart" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="cart" targetRef="out" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="out" targetRef="make" />
