<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_09-tinh-luong" targetNamespace="http://glowskin.local/bpmn">
  <bpmn:collaboration id="Collab_09-tinh-luong">
    <bpmn:participant id="Pool_09-tinh-luong" name="Tính lương hàng tháng" processRef="Process_09-tinh-luong" />
  </bpmn:collaboration>
  <bpmn:process id="Process_09-tinh-luong" name="Tính lương hàng tháng" isExecutable="false">
    <bpmn:laneSet id="LaneSet_09-tinh-luong">
      <bpmn:lane id="Lane_Q" name="Quản lý">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cal2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_N" name="Nhân viên">
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>see</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Cuối tháng">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="view" name="Mở bảng lương tháng">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="apr" name="Duyệt giải trình">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="calc" name="Tổng hợp công, tìm vấn đề chưa xử lý">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Còn vấn đề?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix" name="Nhân viên giải trình, chấm bổ sung">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="gen" name="Tạo bảng lương nháp">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="cal2" name="Tính lương, thưởng chuyên cần">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="adj" name="Thêm khoản cộng hoặc trừ">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="lock" name="Duyệt và khóa bảng lương">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="pub" name="Mở phiếu lương cho nhân viên">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="paid" name="Chuyển lương, nhập mã lệnh chuyển">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="see" name="Xem phiếu lương">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Kết thúc">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="view" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="view" targetRef="calc" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="calc" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_4" name="Có" sourceRef="g1" targetRef="fix" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="fix" targetRef="apr" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="apr" targetRef="calc" />
    <bpmn:sequenceFlow id="Flow_7" name="Không" sourceRef="g1" targetRef="gen" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="gen" targetRef="cal2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="cal2" targetRef="adj" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="adj" targetRef="lock" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="lock" targetRef="pub" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="pub" targetRef="paid" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="paid" targetRef="see" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="see" targetRef="e" />
  </bpmn:process>
