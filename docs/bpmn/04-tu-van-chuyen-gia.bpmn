<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_04-tu-van-chuyen-gia" targetNamespace="http://glowskin.local/bpmn">
  <bpmn:collaboration id="Collab_04-tu-van-chuyen-gia">
    <bpmn:participant id="Pool_04-tu-van-chuyen-gia" name="Tư vấn chuyên gia online" processRef="Process_04-tu-van-chuyen-gia" />
    <bpmn:participant id="Ext_SePay" name="SePay / Ngân hàng" />
    <bpmn:messageFlow id="Msg_1" name="Chuyển tiền" sourceRef="pay" targetRef="Ext_SePay" />
    <bpmn:messageFlow id="Msg_2" name="Báo giao dịch" sourceRef="Ext_SePay" targetRef="msg" />
  </bpmn:collaboration>
  <bpmn:process id="Process_04-tu-van-chuyen-gia" name="Tư vấn chuyên gia online" isExecutable="false">
    <bpmn:laneSet id="LaneSet_04-tu-van-chuyen-gia">
      <bpmn:lane id="Lane_G" name="Chuyên gia">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Q" name="Quản lý">
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_K" name="Khách hàng">
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>less</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Chuyên gia báo lịch rảnh">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="open" name="Mở ca tư vấn">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="choose" name="Chọn chuyên gia, giờ, gửi câu hỏi">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="check" name="Kiểm tra giờ trống, trùng lịch của khách">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Hợp lệ?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="hold" name="Giữ chỗ chờ cọc">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="pay" name="Chuyển cọc qua VietQR">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="wait" name="Chờ tiền về">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="msg" name="Nhận giao dịch">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm" name="Hết giờ giữ chỗ">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_tm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="rel" name="Hủy giữ chỗ">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e0" name="Lịch bị hủy">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="Đủ cọc?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="less" name="Ghi chuyển thiếu vào Đối soát">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="CSKH xử lý">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="conf" name="Xác nhận lịch, thừa tiền thì ghi Đối soát">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="tm1" name="Đến giờ hẹn">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_tm1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="call" name="Tư vấn qua video">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="tm2" name="Phòng đóng sau 45 phút">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_tm2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g3" name="Ai đã vào phòng?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="lost" name="Ghi khách vắng, giữ cọc">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Khách mất cọc">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="res" name="Nhập kết quả, gợi ý sản phẩm">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="tb" name="Quá 24 giờ" attachedToRef="res">
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_tb" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="done" name="Hoàn thành, cọc trừ vào phí khám lần sau">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="view" name="Xem kết quả trong Sổ lịch khám">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e3" name="Kết thúc">
      <bpmn:incoming>Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ref" name="Chuyển sang chờ hoàn cọc">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e4" name="CSKH hoàn cọc">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="open" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="open" targetRef="choose" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="choose" targetRef="check" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="check" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_5" name="Không" sourceRef="g1" targetRef="choose" />
    <bpmn:sequenceFlow id="Flow_6" name="Có" sourceRef="g1" targetRef="hold" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="hold" targetRef="pay" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="pay" targetRef="wait" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="wait" targetRef="msg" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="wait" targetRef="tm" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="tm" targetRef="rel" />
