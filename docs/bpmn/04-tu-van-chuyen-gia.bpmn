    <bpmn:sequenceFlow id="Flow_14" name="Đủ" sourceRef="g2" targetRef="conf" />
    <bpmn:sequenceFlow id="Flow_15" name="Thiếu" sourceRef="g2" targetRef="less" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="less" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="conf" targetRef="tm1" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="tm1" targetRef="call" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="call" targetRef="tm2" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="tm2" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_21" name="Cả hai" sourceRef="g3" targetRef="res" />
    <bpmn:sequenceFlow id="Flow_22" name="Khách vắng" sourceRef="g3" targetRef="lost" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="lost" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_24" name="Chuyên gia vắng" sourceRef="g3" targetRef="ref" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="res" targetRef="done" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="tb" targetRef="ref" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="done" targetRef="view" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="view" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="ref" targetRef="e4" />
  </bpmn:process>
