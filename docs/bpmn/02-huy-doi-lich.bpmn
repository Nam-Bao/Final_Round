<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_02-huy-doi-lich" targetNamespace="http://glowskin.local/bpmn">
  <bpmn:collaboration id="Collab_02-huy-doi-lich">
    <bpmn:participant id="Pool_02-huy-doi-lich" name="Hủy, đổi lịch và khách không đến" processRef="Process_02-huy-doi-lich" />
  </bpmn:collaboration>
  <bpmn:process id="Process_02-huy-doi-lich" name="Hủy, đổi lịch và khách không đến" isExecutable="false">
    <bpmn:laneSet id="LaneSet_02-huy-doi-lich">
      <bpmn:lane id="Lane_K" name="Khách hàng">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nsx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C" name="CSKH">
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Khách muốn đổi hoặc hủy lịch">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g0" name="Yêu cầu?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ack" name="Xác nhận chấp nhận mất cọc">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="pick" name="Chọn ngày giờ mới">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Còn trên 24 giờ, chưa đổi lần nào?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="Liên hệ CSKH">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="lose" name="Hủy lịch, giữ cọc, trả cọc tư vấn đã gắn">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Khách mất cọc">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="mv" name="Khóa khung giờ, cập nhật lịch">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Đã đổi lịch, không mất cọc">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="nsx" name="Giữ cọc, trả cọc tư vấn đã gắn, trả khung giờ">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e4" name="Khách mất cọc">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s3" name="Quá giờ hẹn 15 phút, khách chưa đến">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_s3" />
    </bpmn:startEvent>
    <bpmn:userTask id="ns" name="Ghi nhận khách không đến">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="s2" name="Bác sĩ vắng, sự cố">
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="cc" name="Hủy lịch, ghi lý do">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ref" name="Chuyển khoản hoàn cọc, nhập mã giao dịch">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e3" name="Đã hoàn cọc">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="g0" />
    <bpmn:sequenceFlow id="Flow_2" name="Hủy lịch" sourceRef="g0" targetRef="ack" />
    <bpmn:sequenceFlow id="Flow_3" name="Đổi lịch" sourceRef="g0" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_4" name="Được" sourceRef="g1" targetRef="pick" />
    <bpmn:sequenceFlow id="Flow_5" name="Không" sourceRef="g1" targetRef="e0" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="pick" targetRef="mv" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="mv" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ack" targetRef="lose" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="lose" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="s3" targetRef="ns" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ns" targetRef="nsx" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="nsx" targetRef="e4" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="s2" targetRef="cc" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="cc" targetRef="ref" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ref" targetRef="e3" />
  </bpmn:process>
