  <bpmn:collaboration id="Collab_10-vat-tu-nhap-kho">
    <bpmn:participant id="Pool_10-vat-tu-nhap-kho" name="Xuất vật tư và nhập kho" processRef="Process_10-vat-tu-nhap-kho" />
    <bpmn:participant id="Ext_NCC" name="Nhà cung cấp" />
    <bpmn:messageFlow id="Msg_1" name="Đơn đặt hàng" sourceRef="ord" targetRef="Ext_NCC" />
    <bpmn:messageFlow id="Msg_2" name="Giao hàng" sourceRef="Ext_NCC" targetRef="arr" />
  </bpmn:collaboration>
  <bpmn:process id="Process_10-vat-tu-nhap-kho" name="Xuất vật tư và nhập kho" isExecutable="false">
    <bpmn:laneSet id="LaneSet_10-vat-tu-nhap-kho">
      <bpmn:lane id="Lane_T" name="Kỹ thuật viên">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>use</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>why</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Q" name="Quản lý">
        <bpmn:flowNodeRef>dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Hoàn thành buổi dịch vụ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="use" name="Ghi vật tư thực dùng">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Vượt định mức?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="why" name="Nhập lý do">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="take" name="Trừ kho theo lô, ghi phần thiếu nếu có">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="Dưới tồn tối thiểu?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Đã có đề xuất chưa xong?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="prop" name="Tự tạo đề xuất nhập hàng">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Đủ tồn kho">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e4" name="Đang chờ hàng về">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="dec" name="Xem xét đề xuất">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="Duyệt?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ord" name="Đặt hàng, ghi nhà cung cấp">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="arr" name="Hàng về">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_arr" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="recv" name="Nhận hàng, ghi lô, hạn dùng, giá nhập">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="add" name="Cộng tồn kho theo lô">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Kết thúc">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Đề xuất bị từ chối">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="use" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="use" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_3" name="Có" sourceRef="g1" targetRef="why" />
    <bpmn:sequenceFlow id="Flow_4" name="Không" sourceRef="g1" targetRef="take" />
