<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_10-vat-tu-nhap-kho" targetNamespace="http://glowskin.local/bpmn">
  <bpmn:collaboration id="Collab_10-vat-tu-nhap-kho">
    <bpmn:participant id="Pool_10-vat-tu-nhap-kho" name="Xuất vật tư và nhập kho" processRef="Process_10-vat-tu-nhap-kho" />
  </bpmn:collaboration>
  <bpmn:process id="Process_10-vat-tu-nhap-kho" name="Xuất vật tư và nhập kho" isExecutable="false">
    <bpmn:laneSet id="LaneSet_10-vat-tu-nhap-kho">
      <bpmn:lane id="Lane_T" name="Kỹ thuật viên">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>use</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>why</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Hoàn thành buổi dịch vụ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="use" name="Ghi vật tư thực dùng">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Vượt định mức?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="why" name="Nhập lý do">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="take" name="Trừ kho theo lô, ghi phần thiếu nếu có">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="Dưới tồn tối thiểu?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Đã có đề xuất chưa xong?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="prop" name="Tự tạo đề xuất nhập hàng (người đề xuất: Hệ thống)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Sang quy trình Nhập hàng (sơ đồ 12)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e1" name="Đủ tồn kho">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e4" name="Đang chờ hàng về">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="use" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="use" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_3" name="Có" sourceRef="g1" targetRef="why" />
    <bpmn:sequenceFlow id="Flow_4" name="Không" sourceRef="g1" targetRef="take" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="why" targetRef="take" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="take" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_7" name="Có" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_8" name="Không" sourceRef="g2" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_9" name="Không" sourceRef="g3" targetRef="prop" />
    <bpmn:sequenceFlow id="Flow_10" name="Có" sourceRef="g3" targetRef="e4" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="prop" targetRef="e2" />
  </bpmn:process>
