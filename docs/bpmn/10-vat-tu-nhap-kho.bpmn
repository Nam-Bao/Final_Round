    <bpmn:sequenceFlow id="Flow_8" name="Không" sourceRef="g2" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_9" name="Không" sourceRef="g3" targetRef="prop" />
    <bpmn:sequenceFlow id="Flow_10" name="Có" sourceRef="g3" targetRef="e4" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="prop" targetRef="dec" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="dec" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_13" name="Có" sourceRef="g4" targetRef="ord" />
    <bpmn:sequenceFlow id="Flow_14" name="Không" sourceRef="g4" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ord" targetRef="arr" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="arr" targetRef="recv" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="recv" targetRef="add" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="add" targetRef="e2" />
  </bpmn:process>
