    <bpmn:sequenceFlow id="Flow_9" sourceRef="wg" targetRef="bad" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="bad" targetRef="pick" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ok" targetRef="recv" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="recv" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_13" name="Có" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_14" name="Không" sourceRef="g2" targetRef="rej2" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="rej2" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_16" name="Có" sourceRef="g3" targetRef="stock" />
    <bpmn:sequenceFlow id="Flow_17" name="Không" sourceRef="g3" targetRef="nost" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="stock" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="nost" targetRef="e3" />
  </bpmn:process>
