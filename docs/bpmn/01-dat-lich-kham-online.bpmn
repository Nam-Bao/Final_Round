<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_01-dat-lich-kham-online" targetNamespace="http://glowskin.local/bpmn">
  <bpmn:collaboration id="Collab_01-dat-lich-kham-online">
    <bpmn:participant id="Pool_01-dat-lich-kham-online" name="Đặt lịch khám online và thanh toán cọc" processRef="Process_01-dat-lich-kham-online" />
    <bpmn:participant id="Ext_SePay" name="SePay / Ngân hàng" />
    <bpmn:messageFlow id="Msg_1" name="Chuyển tiền" sourceRef="pay" targetRef="Ext_SePay" />
    <bpmn:messageFlow id="Msg_2" name="Báo giao dịch" sourceRef="Ext_SePay" targetRef="msg" />
  </bpmn:collaboration>
  <bpmn:process id="Process_01-dat-lich-kham-online" name="Đặt lịch khám online và thanh toán cọc" isExecutable="false">
    <bpmn:laneSet id="LaneSet_01-dat-lich-kham-online">
      <bpmn:lane id="Lane_K" name="Khách hàng">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>over</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>less</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Khách muốn đặt lịch">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="choose" name="Chọn bác sĩ, ngày giờ, hồ sơ người khám">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="check" name="Kiểm tra ca làm, khóa khung giờ">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Khung giờ còn trống?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="Hồ sơ đã từng khám?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="free" name="Chốt lịch, khách cũ miễn cọc và phí khám">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Lịch đã xác nhận">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="hold" name="Tạo lịch giữ chỗ và hóa đơn cọc">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="pay" name="Chuyển khoản qua mã VietQR">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="wait" name="Chờ tiền về">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="msg" name="Nhận giao dịch">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm" name="Hết giờ giữ chỗ">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_tm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="rel" name="Hủy giữ chỗ, trả khung giờ">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Lịch bị hủy">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="match" name="Đối chiếu mã lịch và số tiền">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g3" name="Số tiền?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ok" name="Ghi nhận cọc, xác nhận lịch">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e3" name="Lịch đã xác nhận">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="over" name="Xác nhận lịch, ghi phần dư vào Đối soát">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e4" name="CSKH hoàn phần dư">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="less" name="Ghi chuyển thiếu vào Đối soát">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e5" name="CSKH xử lý">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="late" name="Tiền về sau khi hết giữ chỗ">
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_late" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="lg" name="Ghi chưa khớp vào Đối soát">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e6" name="CSKH hoàn tiền">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="choose" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="choose" targetRef="check" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="check" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_4" name="Không" sourceRef="g1" targetRef="choose" />
    <bpmn:sequenceFlow id="Flow_5" name="Có" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_6" name="Lần đầu" sourceRef="g2" targetRef="hold" />
    <bpmn:sequenceFlow id="Flow_7" name="Rồi" sourceRef="g2" targetRef="free" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="free" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="hold" targetRef="pay" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="pay" targetRef="wait" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="wait" targetRef="msg" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="wait" targetRef="tm" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="tm" targetRef="rel" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="rel" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="msg" targetRef="match" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="match" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_17" name="Đủ" sourceRef="g3" targetRef="ok" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="ok" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_19" name="Thừa" sourceRef="g3" targetRef="over" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="over" targetRef="e4" />
    <bpmn:sequenceFlow id="Flow_21" name="Thiếu" sourceRef="g3" targetRef="less" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="less" targetRef="e5" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="late" targetRef="lg" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="lg" targetRef="e6" />
  </bpmn:process>
