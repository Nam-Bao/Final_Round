  <bpmn:collaboration id="Collab_08-cham-cong">
    <bpmn:participant id="Pool_08-cham-cong" name="Chấm công nhân viên" processRef="Process_08-cham-cong" />
  </bpmn:collaboration>
  <bpmn:process id="Process_08-cham-cong" name="Chấm công nhân viên" isExecutable="false">
    <bpmn:laneSet id="LaneSet_08-cham-cong">
      <bpmn:lane id="Lane_N" name="Nhân viên">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_M" name="Máy chấm công">
        <bpmn:flowNodeRef>qr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_H" name="Hệ thống">
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>abs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>okv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Q" name="Quản lý">
        <bpmn:flowNodeRef>rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Đến giờ vào ca hoặc ra ca">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="qr" name="Hiện mã QR động 20 giây">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="scan" name="Quét mã QR">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="chk" name="Kiểm tra mã, ca làm, khung giờ">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Kết quả?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="Không có ca đang mở, dừng">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="photo" name="Chụp ảnh xác nhận">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="save" name="Ghi nhận công">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="Có vi phạm?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Công hợp lệ">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="exp" name="Gửi giải trình trong 24 giờ">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="tb" name="Quá 24 giờ" attachedToRef="exp">
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_tb" />
    </bpmn:boundaryEvent>
    <bpmn:startEvent id="s2" name="Hết ca mà không chấm công">
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_s2" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="abs" name="Mở giải trình, quá hạn tự ghi vắng">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e4" name="Kết thúc">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="rev" name="Xem xét giải trình">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="Chấp nhận?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="okv" name="Không tính vi phạm">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Kết thúc">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="keep" name="Giữ vi phạm, tính vào lương">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e3" name="Kết thúc">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="qr" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="qr" targetRef="scan" />
