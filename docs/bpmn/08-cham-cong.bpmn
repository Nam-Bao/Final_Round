    <bpmn:sequenceFlow id="Flow_7" name="Hợp lệ" sourceRef="g1" targetRef="photo" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="photo" targetRef="save" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="save" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_10" name="Không" sourceRef="g2" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_11" name="Có" sourceRef="g2" targetRef="exp" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="exp" targetRef="rev" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="tb" targetRef="keep" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="rev" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_15" name="Có" sourceRef="g3" targetRef="okv" />
    <bpmn:sequenceFlow id="Flow_16" name="Không" sourceRef="g3" targetRef="keep" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="okv" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="keep" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="s2" targetRef="abs" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="abs" targetRef="e4" />
  </bpmn:process>
