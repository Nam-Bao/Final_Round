# Phải giống hệt JWT_SECRET của service-identity
JWT_SECRET=
# Lấy tại console.zegocloud.com (dùng cho phòng khám video)
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
# API key cấu hình trong webhook SePay (header Authorization: Apikey <key>)
SEPAY_API_KEY=
# Chỉ bật true 1 lần khi lấy code mới có thay đổi model (backup DB trước), sau đó tắt
DB_SYNC_ALTER=false
