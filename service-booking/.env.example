# Phải giống hệt JWT_SECRET của service-identity
JWT_SECRET=
# Lấy tại console.zegocloud.com (dùng cho phòng khám video)
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
# API key cấu hình trong webhook SePay (header Authorization: Apikey <key>)
SEPAY_API_KEY=
# Chỉ bật true 1 lần khi lấy code mới có thay đổi model (backup DB trước), sau đó tắt
DB_SYNC_ALTER=false

# Địa chỉ service-identity (lấy danh sách nhân viên cho bảng lương)
IDENTITY_SERVICE_URL=http://localhost:4001
# Khoá nội bộ cho service-commerce gọi service-booking, phải giống nhau ở 2 service
INTERNAL_API_KEY=

# Phí 1 buổi tư vấn chuyên gia (đồng, mặc định 300000). Không trừ vào phí khám
CONSULT_FEE=

# ---- Mốc thời gian chờ (bỏ trống = quy định thật). Khi demo / test đặt ngắn lại để không phải chờ, demo xong xóa đi.
# Giữ chỗ chờ cọc lịch khám, lịch tư vấn (phút, mặc định 15). Demo: 2
PAYMENT_HOLD_MINUTES=
# Quá giờ hẹn bao lâu mới ghi "khách không đến" (phút, mặc định 15). Demo: 1
NO_SHOW_GRACE_MINUTES=
# Khách tự đổi lịch khám / tư vấn trước giờ hẹn ít nhất (giờ, mặc định 24). Demo: 1
RESCHEDULE_MIN_HOURS=
# Chuyên gia vào phòng tư vấn sớm (phút, mặc định 15)
EXPERT_OPEN_BEFORE_MINUTES=
# Phòng tư vấn đóng sau giờ hẹn (phút, mặc định 45). Demo: 5
CONSULT_ROOM_CLOSE_MINUTES=
# Tư vấn tối thiểu trước khi gửi kết quả (phút, mặc định 5). Demo: 1
CONSULT_MIN_SESSION_MINUTES=
# Hạn chuyên gia gửi kết quả sau khi phòng đóng (giờ, mặc định 24, cho phép số lẻ). Demo: 0.2 (12 phút)
CONSULT_RESULT_DEADLINE_HOURS=
# Mã QR chấm công sống (giây, mặc định 20). Demo: 60
ATTENDANCE_QR_TTL_SECONDS=
# Hạn giải trình chấm công sau khi hết ca, quá hạn tự ghi vắng (giờ, mặc định 24). Demo: 0.2
ATTENDANCE_EXPLAIN_HOURS=
