# Phải giống hệt JWT_SECRET của service-identity
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Chỉ bật true 1 lần khi lấy code mới có thay đổi model (backup DB trước), sau đó tắt
DB_SYNC_ALTER=false
# Địa chỉ service-identity (lấy tên, ảnh bác sĩ cho bài nghiên cứu)
IDENTITY_SERVICE_URL=http://localhost:4001

# ===== Triển khai (để trống = chạy trên máy cá nhân) =====
# Cổng service (nền tảng như Render tự đặt PORT), mặc định 4005
PORT=
# Kết nối PostgreSQL, mặc định khớp docker-compose (localhost:5436, media_db, postgres/password)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Database trên cloud (Neon, Supabase, Render...) cần SSL thì đặt true
DB_SSL=
# Địa chỉ service identity (gửi thông báo), mặc định http://localhost:4001
IDENTITY_URL=
