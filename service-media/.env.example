# Phải giống hệt JWT_SECRET của service-identity
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Chỉ bật true 1 lần khi lấy code mới có thay đổi model (backup DB trước), sau đó tắt
DB_SYNC_ALTER=false
# Địa chỉ service-identity (lấy tên, ảnh bác sĩ cho bài nghiên cứu)
IDENTITY_SERVICE_URL=http://localhost:4001
