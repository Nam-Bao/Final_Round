# Tài khoản nhận chuyển khoản VietQR (hiển thị mã QR thanh toán)
VITE_BANK_ID=
VITE_ACCOUNT_NO=
VITE_ACCOUNT_NAME=
# Địa chỉ phòng khám (footer, trang Liên hệ, Giới thiệu) và địa chỉ đầy đủ để tra bản đồ Google Maps
VITE_CLINIC_ADDRESS=
VITE_CLINIC_MAP_QUERY=
# Địa chỉ backend khi build đưa lên máy chủ. Để trống: gọi /api qua proxy của Vite (chạy dev)
# API Gateway, vd https://api.glowskin.vn
VITE_API_URL=
# Service identity (Socket.IO chat với CSKH)
VITE_SOCKET_URL=
