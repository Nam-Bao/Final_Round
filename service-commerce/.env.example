# Phải giống hệt JWT_SECRET của service-identity
JWT_SECRET=
# Chỉ bật true 1 lần khi lấy code mới có thay đổi model (backup DB trước), sau đó tắt
DB_SYNC_ALTER=false
# Webhook SePay cho đơn mỹ phẩm: giống SEPAY_API_KEY của service-booking (SePay gửi "Authorization: Apikey <khoá>")
SEPAY_API_KEY=
# Giao Hàng Nhanh (GHN): token & mã cửa hàng lấy trong trang quản trị GHN
GHN_TOKEN=
GHN_SHOP_ID=
# Khoá bí mật cho webhook GHN: khai báo URL webhook dạng .../api/commerce/orders/ghn-webhook?token=<khoá>
GHN_WEBHOOK_SECRET=
# Kho GlowSkin trên GHN: điểm lấy hàng đơn giao đi & điểm nhận hàng đơn hoàn trả.
# Mã phường (WARD_CODE) và mã quận (DISTRICT_ID) tra trong danh mục địa chỉ GHN.
GHN_FROM_NAME=
GHN_FROM_PHONE=
GHN_FROM_ADDRESS=
GHN_FROM_WARD_CODE=
GHN_FROM_DISTRICT_ID=
# Bỏ trống = GHN production. Chạy thử với tài khoản test: https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_API_BASE_URL=
