# Chuỗi ngẫu nhiên dài, dùng chung cho mọi service
JWT_SECRET=
# Chỉ bật true 1 lần khi lấy code mới có thay đổi model (backup DB trước), sau đó tắt
DB_SYNC_ALTER=false

# Tệp gửi trong chat CSKH: nhờ service-media xoá khi hết hạn lưu
MEDIA_URL=http://localhost:4005
CHAT_FILE_RETENTION_DAYS=730
GATEWAY_URL=http://localhost:4000

# ===== Email gửi khách (quên mật khẩu, xác nhận lịch, đơn hàng, nhắc lịch) =====
# MAIL_MODE=smtp: gửi thật qua SMTP; MAIL_MODE=log: không gửi, ghi email ra thư mục MAIL_LOG_DIR (mặc định service-identity/mail-outbox) để xem
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=email gmail, SMTP_PASS=mật khẩu ứng dụng 16 ký tự
# (Tài khoản Google > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng). Không dùng mật khẩu đăng nhập Gmail.
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_LOG_DIR=
# Link trong email trỏ về website khách hàng
CLIENT_URL=http://localhost:3001
# Địa chỉ phòng khám mặc định ở chân email khi Quản lý trang > Thông tin phòng khám chưa nhập
CLINIC_ADDRESS=

# ===== Triển khai (để trống = chạy trên máy cá nhân) =====
# Cổng service (nền tảng như Render tự đặt PORT), mặc định 4001
PORT=
# Kết nối PostgreSQL, mặc định khớp docker-compose (localhost:5435, identity_db, postgres/password)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Database trên cloud (Neon, Supabase, Render...) cần SSL thì đặt true
DB_SSL=
# Web được kết nối Socket.IO, cách nhau dấu phẩy (mặc định http://localhost:3000,http://localhost:3001)
CORS_ORIGINS=

# Link trong email gửi nhân viên (vd quản lý xem biên bản nhận hàng / kiểm kho lệch), mặc định http://localhost:3000
ADMIN_URL=
