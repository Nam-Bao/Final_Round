# Chatbot tư vấn trên web khách (trước đây là VITE_GEMINI_API_KEY ở frontend)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Phân tích ảnh da (Roboflow)
ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
# Mô tả da bằng Gemini khi Roboflow không chắc chắn (dùng GEMINI_API_KEY ở trên). Mặc định gemini-3.6-flash
VISION_MODEL=
VISION_FALLBACK_MODEL=
# Số lượt mô tả da tối đa mỗi ngày (mặc định 50)
VISION_DAILY_CAP=
# Hạn mức quét da: khách vãng lai 1 lượt / 24 giờ theo IP, đã đăng nhập 3 lượt / ngày
AI_GUEST_LIMIT=
AI_GUEST_WINDOW_HOURS=
AI_USER_DAILY_LIMIT=
# AI rà soát đơn kê của bác sĩ (dùng GEMINI_API_KEY ở trên). Mặc định gemini-3.6-flash, dự phòng gemini-3.5-flash-lite
SAFETY_MODEL=
SAFETY_FALLBACK_MODEL=
# Phải giống JWT_SECRET của các service khác
JWT_SECRET=
MONGO_URI=mongodb://localhost:27017/medical_db

# Địa chỉ service + lưu / xác nhận soi da
GATEWAY_URL=http://localhost:4000
IDENTITY_URL=http://localhost:4001
MEDIA_URL=http://localhost:4005
SCAN_RETENTION_DAYS=730
SCAN_REVIEW_DUE_HOURS=48
CLINIC_SCAN_DAILY_CAP=60
# Xác thực ảnh chấm công: khoảng cách khuôn mặt < MATCH => khớp, < REVIEW => cần xem lại, còn lại => không khớp
FACE_MATCH_THRESHOLD=0.45
FACE_REVIEW_THRESHOLD=0.6
# Chatbot RAG + AI rà soát đơn: embedding kho kiến thức (dùng GEMINI_API_KEY). Mặc định gemini-embedding-001, 768 chiều
EMBED_MODEL=
EMBED_DIM=
# Nạp lại kho kiến thức định kỳ (phút, mặc định 30). Chỉ tạo lại embedding cho đoạn mới / đổi nội dung
KNOWLEDGE_REFRESH_MINUTES=
# Khách đồng ý cho chatbot xem lịch hẹn / điểm / đơn hàng: hiệu lực trong phiên chat, tối đa bao nhiêu phút (mặc định 60)
CHAT_CONSENT_MINUTES=
