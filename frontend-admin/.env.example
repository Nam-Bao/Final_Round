# Địa chỉ phòng khám mặc định in trên chứng từ khi Quản lý trang > Thông tin phòng khám chưa nhập (giống frontend-client)
VITE_CLINIC_ADDRESS=
# Địa chỉ backend khi build đưa lên máy chủ (để trống = máy cá nhân)
# API Gateway, mặc định http://localhost:4000
VITE_API_URL=
# Service identity (Socket.IO chat, thông báo), mặc định http://localhost:4001
VITE_SOCKET_URL=
# Web khách (link xem trang, sản phẩm), mặc định http://localhost:3001
VITE_CLIENT_URL=
